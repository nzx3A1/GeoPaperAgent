# Application client endpoints. These values match the local Compose port mappings.
DATABASE_URL=postgresql://postgresql:123456789@127.0.0.1:5532/geopaperagent
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
REDIS_URL=redis://:123456789@127.0.0.1:6479/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=geopaperagent
MINIO_SECRET_KEY=123456789
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PAPER_BUCKET=papers
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
NEO4J_URI=bolt://127.0.0.1:7787
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=123456789
NEO4J_DATABASE=neo4j
INFRASTRUCTURE_CONNECT_TIMEOUT=10

# Compose initialization values. Keep these synchronized if compose.yml is changed.
POSTGRESQL_DATABASE=geopaperagent
POSTGRESQL_USER=postgresql
POSTGRESQL_PASSWORD=123456789
REDIS_PASSWORD=123456789
MINIO_ROOT_USER=geopaperagent
MINIO_ROOT_PASSWORD=123456789
MILVUS_MINIO_ACCESS_KEY=milvusadmin
MILVUS_MINIO_SECRET_KEY=123456789
NEO4J_AUTH=neo4j/123456789

# SSH/SFTP PDF source (keep real credentials in .env, never commit them)
SSH_HOST=10.16.35.175
SSH_PORT=22
SSH_USERNAME=nzx
SSH_PASSWORD=change-me
SSH_REMOTE_PDF_DIR=/house1/KUN_QT_DATA/PDF_all
# SSH_KEY_FILE=C:/Users/you/.ssh/id_ed25519
# SSH_KNOWN_HOSTS=C:/Users/you/.ssh/known_hosts
# SSH_ACCEPT_UNKNOWN_HOST_KEY=false

# MinerU and optional LLM metadata extraction
MINERU_API_KEY=change-me
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL=3
MINERU_TIMEOUT=120
MINERU_MAX_WAIT_SECONDS=1800
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=qwen3
